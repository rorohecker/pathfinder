// Lean High Fantasy atmosphere for Pathfinder.
// Wind / ember / sparkle motes — companion to fantasy_icons.slint pixel glyphs.
// Effects (theme-gated by the caller via `active`):
//   1. Divine wind — parchment dust streaming one way across the canopy
//   2. Ember drift — warmer, slower rising motes
//   3. Star sparkles — fixed points that quietly twinkle
//
// No TouchArea: decorative only; pointer events pass through to chrome below.
// Parent should place this above opaque panes but below modal overlays.

export component FantasyAtmosphere inherits Rectangle {
    in property <bool> active: false;
    // When false, Timers stop so minimized / hidden / off-theme windows idle cheaply.
    in property <bool> running: true;

    width: 100%;
    height: 100%;
    background: transparent;
    visible: root.active;

    property <bool> anim_on: root.active && root.running;

    // Shared wind clock — wraps 0→1. Motes sample this with a phase offset so
    // the stream never reverses (no ease-in-out ping-pong / "spring" feel).
    // 33ms (~30 Hz) keeps dust silky without matching full display refresh.
    property <float> wind_t: 0.0;
    Timer {
        interval: 33ms;
        running: root.anim_on;
        triggered => {
            // Full sweep ~14s (0.0023 × ~30/s).
            wind_t = Math.mod(root.wind_t + 0.0023, 1.0);
        }
    }

    // --- Divine wind: cool parchment dust streaming left → right ----------
    // Each mote enters off the left, exits off the right, then wraps. Soft
    // sine lift keeps it organic; fade in/out at the edges. Trails are long
    // and thin along the wind vector — like breath across the forest.
    for m[i] in [
        { phase: 0.00, y0: 0.12, dy: 0.04, amp: 0.018 },
        { phase: 0.12, y0: 0.28, dy: 0.03, amp: 0.022 },
        { phase: 0.25, y0: 0.18, dy: 0.05, amp: 0.015 },
        { phase: 0.38, y0: 0.48, dy: 0.02, amp: 0.020 },
        { phase: 0.50, y0: 0.36, dy: 0.04, amp: 0.016 },
        { phase: 0.62, y0: 0.58, dy: 0.03, amp: 0.019 },
        { phase: 0.74, y0: 0.22, dy: 0.05, amp: 0.014 },
        { phase: 0.86, y0: 0.70, dy: 0.02, amp: 0.021 },
    ] : Rectangle {
        width: 1px;
        height: 1px;
        background: transparent;
        // Progress along the sweep (wraps independently per mote).
        property <float> t: Math.mod(root.wind_t + m.phase, 1.0);
        // Enter at -8% width, exit at 108% — wrap jump is off-screen.
        property <float> mx: -0.08 + t * 1.16;
        property <float> my: m.y0 + t * m.dy
            + m.amp * Math.sin(t * 720deg + m.phase * 360deg);
        // Soft fade at entry / exit so motes dissolve like breath.
        property <float> fade: t < 0.10
            ? (t / 0.10)
            : (t > 0.88 ? ((1.0 - t) / 0.12) : 1.0);

        // Far wisp — long soft streak behind the mote along the wind.
        Rectangle {
            width: 22px;
            height: 1.5px;
            border-radius: 1px;
            background: #f2e8c8;
            opacity: 0.06 * fade;
            x: mx * root.width - self.width - 2px;
            y: my * root.height - self.height / 2;
        }
        // Near wisp.
        Rectangle {
            width: 12px;
            height: 1.5px;
            border-radius: 1px;
            background: #f2e8c8;
            opacity: 0.11 * fade;
            x: mx * root.width - self.width - 1px;
            y: my * root.height - self.height / 2;
        }
        // Mote head — soft parchment dust.
        Rectangle {
            width: 3px;
            height: 3px;
            border-radius: 1.5px;
            background: #f2e8c8;
            x: mx * root.width - 1.5px;
            y: my * root.height - 1.5px;
            opacity: 0.28 * fade;
        }
    }

    // --- Ember drift: warmer bronze motes, rising slowly (still linear) ---
    // One-way upward wrap — not a bounce — so they feel like rising ash.
    property <float> ember_t: 0.0;
    Timer {
        interval: 33ms;
        running: root.anim_on;
        triggered => {
            // Full rise ~15s (0.0022 × ~30/s).
            ember_t = Math.mod(root.ember_t + 0.0022, 1.0);
        }
    }
    for e[i] in [
        { phase: 0.05, x0: 0.18, dx: 0.04 },
        { phase: 0.28, x0: 0.42, dx: -0.03 },
        { phase: 0.47, x0: 0.62, dx: 0.025 },
        { phase: 0.66, x0: 0.78, dx: -0.02 },
        { phase: 0.84, x0: 0.33, dx: 0.03 },
    ] : Rectangle {
        width: 4px;
        height: 4px;
        border-radius: 2px;
        background: #e0b23c;
        property <float> t: Math.mod(root.ember_t + e.phase, 1.0);
        // Rise from below the floor to above the canopy, wrap off-screen.
        property <float> ey: 1.05 - t * 1.20;
        property <float> ex: e.x0 + t * e.dx;
        property <float> fade: t < 0.12
            ? (t / 0.12)
            : (t > 0.85 ? ((1.0 - t) / 0.15) : 1.0);
        x: ex * root.width - 2px;
        y: ey * root.height - 2px;
        opacity: 0.26 * fade;
    }

    // --- Star sparkles: fixed twinkles (stardust over the canopy) ---------
    for s[i] in [
        { x: 0.12, y: 0.06, dur: 2800ms },
        { x: 0.34, y: 0.48, dur: 3400ms },
        { x: 0.58, y: 0.09, dur: 3800ms },
        { x: 0.76, y: 0.62, dur: 2400ms },
        { x: 0.91, y: 0.28, dur: 3200ms },
        { x: 0.05, y: 0.55, dur: 4000ms },
        { x: 0.45, y: 0.88, dur: 3600ms },
        { x: 0.68, y: 0.38, dur: 3000ms },
        { x: 0.22, y: 0.72, dur: 3700ms },
        { x: 0.85, y: 0.80, dur: 3300ms },
    ] : Rectangle {
        width: 2px;
        height: 2px;
        border-radius: 1px;
        background: #e8c478;
        x: s.x * root.width;
        y: s.y * root.height;
        // Stagger initial lit state so the field twinkles from frame one.
        property <bool> lit: Math.mod(i, 2) == 1;
        Timer {
            interval: s.dur;
            running: root.anim_on;
            triggered => { lit = !lit; }
        }
        opacity: lit ? 0.90 : 0.12;
        animate opacity { duration: s.dur; easing: ease-in-out; }
    }
}

// Hover-only gold sparkles for the fantasy treasure-chest folder icon.
// Three tiny motes — no Timer, no pixel grid. Parent supplies `lit`.
export component FantasyChestSparkles inherits Rectangle {
    in property <bool> lit: false;
    width: 100%;
    height: 100%;
    background: transparent;

    for offset[i] in [0.28, 0.48, 0.68] : Rectangle {
        width: 3px;
        height: 3px;
        border-radius: 1.5px;
        background: #e0b23c;
        x: offset * root.width;
        y: root.lit ? root.height * 0.05 : root.height * 0.42;
        opacity: root.lit ? 0.0 : 0.85;
        animate y { duration: 550ms + i * 90ms; easing: ease-out; }
        animate opacity { duration: 550ms + i * 90ms; easing: ease-in; }
    }
}
